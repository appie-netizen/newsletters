<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ config.publication }}{% endblock %}</title>
{% block head %}{% endblock %}
<link rel="alternate" type="application/rss+xml" title="{{ config.publication }}" href="{{ rel }}feed.xml">
<link rel="stylesheet" href="{{ rel }}assets/style.css">
</head>
<body>
<header class="site-header">
  <a class="wordmark" href="{{ rel }}index.html">{{ config.publication }}</a>
  <p class="tagline">{{ config.tagline }}</p>
</header>
<main>
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
  <p>{{ config.publication }} &mdash; by {{ config.author }}</p>
  <p>
  {%- for l in config.links %}<a href="{{ rel }}{{ l.href }}">{{ l.label }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor -%}
  </p>
</footer>
</body>
</html>
