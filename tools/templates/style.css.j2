/* Generated by build_site.py from newsletter.config.yaml. Do not edit by hand. */
{% set L = config.theme.light %}
{% set D = config.theme.dark %}
:root {
  --bg: {{ L.bg }};
  --surface: {{ L.surface }};
  --text: {{ L.text }};
  --muted: {{ L.muted }};
  --accent: {{ L.accent }};
  --border: {{ L.border }};
  --maxw: {{ config.theme.max_width_px }}px;
  --font: {{ config.theme.font_stack }};
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: {{ D.bg }};
    --surface: {{ D.surface }};
    --text: {{ D.text }};
    --muted: {{ D.muted }};
    --accent: {{ D.accent }};
    --border: {{ D.border }};
  }
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  font-size: 18px;
  line-height: 1.65;
}
main { max-width: var(--maxw); margin: 0 auto; padding: 0 20px 64px; }
a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
a:hover { text-decoration: none; }
img { max-width: 100%; height: auto; display: block; }

.site-header {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 40px 20px 24px;
  border-bottom: 1px solid var(--border);
}
.wordmark {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text);
  text-decoration: none;
}
.tagline { margin: 4px 0 0; color: var(--muted); font-size: 15px; }

.site-footer {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 32px 20px 56px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 14px;
}
.site-footer p { margin: 4px 0; }
.site-footer a { color: var(--muted); }

/* index */
.issue-list { list-style: none; margin: 0; padding: 32px 0 0; }
.issue-card { border-bottom: 1px solid var(--border); }
.issue-card-link {
  display: grid;
  grid-template-columns: 96px 1fr;
  grid-template-areas: "thumb meta" "thumb title" "thumb dek";
  gap: 2px 18px;
  padding: 22px 0;
  text-decoration: none;
  color: var(--text);
}
.issue-card-link:has(:only-child), .issue-card-link:not(:has(.thumb)) { grid-template-columns: 1fr; }
.thumb {
  grid-area: thumb;
  width: 96px; height: 96px;
  object-fit: cover;
  border-radius: 8px;
  background: var(--surface);
}
.ic-meta { grid-area: meta; color: var(--muted); font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; }
.ic-title { grid-area: title; font-size: 20px; font-weight: 650; line-height: 1.3; }
.ic-dek { grid-area: dek; color: var(--muted); font-size: 15px; }
.issue-card-link:hover .ic-title { color: var(--accent); }
.empty { color: var(--muted); padding-top: 40px; }

/* issue */
.issue { padding-top: 40px; }
.issue-meta { color: var(--muted); font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 8px; }
.issue h1 { font-size: 34px; line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 12px; }
.dek { font-size: 20px; color: var(--muted); margin: 0 0 8px; }
.issue-section { margin-top: 36px; }
.issue-section h2 { font-size: 22px; margin: 0 0 12px; letter-spacing: -0.01em; }
.issue-section p { margin: 0 0 16px; }
blockquote {
  margin: 20px 0;
  padding: 4px 0 4px 18px;
  border-left: 3px solid var(--accent);
  color: var(--muted);
  font-style: italic;
}
figure { margin: 0 0 20px; }
figure img { border-radius: 10px; border: 1px solid var(--border); }
figcaption { color: var(--muted); font-size: 14px; margin-top: 8px; }

.badge {
  display: inline-block;
  background: var(--accent);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 4px;
  letter-spacing: 0.03em;
}

.sources { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--border); }
.sources h2 { font-size: 16px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
.sources ol { margin: 0; padding-left: 20px; }
.sources li { font-size: 15px; margin: 6px 0; word-break: break-word; }

.issue-nav {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 48px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  font-size: 15px;
}

@media (max-width: 480px) {
  body { font-size: 17px; }
  .issue h1 { font-size: 27px; }
  .dek { font-size: 18px; }
}
