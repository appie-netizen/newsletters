# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM backend: set at least one key ---
# Gemini (free tier covers research, drafting, and illustrations):
#   get a key at https://aistudio.google.com
GEMINI_API_KEY=

# Claude (alternative for research + drafting; no free tier):
ANTHROPIC_API_KEY=

# --- Optional overrides ---
# Force a backend regardless of which keys are set: anthropic | gemini
# NEWSLETTER_PROVIDER=gemini

# Text model override (per active backend).
# GEMINI_MODEL=gemini-2.5-flash
# NEWSLETTER_MODEL=claude-opus-5

# Illustration model (Gemini).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Anthropic web-search tool variant, if the API rejects the default.
# WEB_SEARCH_TOOL_TYPE=web_search_20260209
