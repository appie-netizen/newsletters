# Copy to .env and fill in real values. NEVER commit .env.

# --- Required ---
# Claude API key — used for research (web search) and drafting.
ANTHROPIC_API_KEY=

# --- Optional ---
# Override the Claude model (default: claude-opus-5).
# NEWSLETTER_MODEL=claude-opus-5

# Override the web search tool variant if the API rejects the default.
# WEB_SEARCH_TOOL_TYPE=web_search_20260209
