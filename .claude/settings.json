      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(*/.venv/Scripts/python.exe:*)",
      "Bash(*.venv/Scripts/python.exe*)",
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(python -m playwright:*)",
      "Bash(python -m http.server:*)",
      "Bash(playwright:*)",

      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm ci:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run start)",
      "Bash(npm run start:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run:*)",
      "Bash(npx --yes:*)",
      "Bash(node:*)",

      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git config --get:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",

      "Bash(gh:*)",
      "Bash(/c/Program Files/GitHub CLI/gh.exe:*)",
      "Bash(\"/c/Program Files/GitHub CLI/gh.exe\":*)",

      "Bash(netstat:*)",
      "Bash(taskkill:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl -I http://localhost:*)",
      "Bash(curl -sI http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s http://127.0.0.1:*)",

      "Bash(ffmpeg:*)",
      "Bash(*ffmpeg-win-x86_64*)",
      "Bash(*imageio_ffmpeg*)",

      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(file:*)",
      "Bash(unzip:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(true)"
